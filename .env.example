# Gate API v4: create a separate read-only key. Do not set an IP whitelist when
# deploying on Vercel Hobby, because its outgoing IP addresses are dynamic.
GATE_API_KEY=
GATE_API_SECRET=
GATE_API_BASE_URL=https://api.gateio.ws

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Use a long random string. Required for every /api/check call.
CHECK_SECRET=

# Upstash Redis REST database (required: prevents duplicate messages)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning
TRANSACTION_PAGE_SIZE=100
STATE_TTL_SECONDS=2592000

# Public Gate promotions page. The first launch stores current cards without
# publishing them; future new card links produce Telegram notifications.
PROMOTION_PAGE_URL=https://www.gate.com/ru/rewards_hub/activity-center-1-ongoing
